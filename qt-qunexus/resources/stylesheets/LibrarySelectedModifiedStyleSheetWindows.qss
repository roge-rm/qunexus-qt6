QListView
{
    show-decoration-selected: 1;
    background:rgba(67, 67, 67, 255);
    border-bottom-left-radius:4.0;
    border-bottom-right-radius:4.0;
    border-top-left-radius:4.0;
    border-top-right-radius:4.0;
    border: 1px solid black;
    padding: 6 0 6 0;
    color: rgba(175,175,175,255);
    font: 8pt "Open Sans Semibold";
 }

 QListView::item:selected
 {
    background: qlineargradient(spread:repeat, x1:1, y1:0, x2:1, y2:1, stop:0 rgba(162, 0, 0, 180), stop:1 rgba(162, 0, 0, 180));
    color: rgba(241,101,65,255);
 }

 QListView::item:hover
 {QListView {
    show-decoration-selected: 1;
    background:rgba(67, 67, 67, 255);
    border-bottom-left-radius:4.0;
    border-bottom-right-radius:4.0;
    border-top-left-radius:4.0;
    border-top-right-radius:4.0;
    border: 1px solid black;
    padding: 6 0 6 0;
    color: rgba(175,175,175,255);
    font: 12pt "Arial";
 }

 QListView::item:selected {
 background: rgba(162, 0, 0, 200);
 color: rgba(175,175,175, 255);
 }

 QListView::item:hover {
    background: qlineargradient(spread:repeat, x1:1, y1:0, x2:1, y2:1, stop:0 rgba(67, 67, 67, 100), stop:1 rgba(150, 150, 150, 100));
    color: rgba(175,175,175,255);
 }

QListView::item:hover:selected {
    background: rgba(162, 0, 0, 200);
    color: rgba(255,255,255,255);
}


