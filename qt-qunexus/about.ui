}

QComboBox {
        font-family: &quot;Arial&quot;;
        font-size: 9px;
        background: #666;
        padding: 2px 4px;
        border-style: outset;
        border-radius: 4px;
        border-width: 1px;
        border-color: black;
        color: white;
}

QComboBox::drop-down:button {
        width: 15px;
        height: 15px;
}

QComboBox::down-arrow {
        image: url(:/images/resources/images/white-drop-down-arrow-gray.png);
        width: 10px;
        height: 10px;
        top: 2px;
        right: 3px;
}
QComboBox::down-arrow:disabled {
        image: url(url(:/images/resources/images/Arrow.png));
        right: 30px;
}



QListView {
        background: rgba(67, 67, 67, 255);
