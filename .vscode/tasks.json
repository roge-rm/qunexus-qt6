{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "QuNexus Win Build (Debug)",
      "type": "process",
      "command": "${workspaceFolder}\\.vscode\\run-msvc-qmake-task.cmd",
      "args": [
        "..\\QuNexus.pro",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\qt-qunexus\\build-QuNexus-Desktop_Qt_6_3_2_MSVC2019_64bit-Debug",
        "dedicatedTasks": {
          "label": "$(rocket) Build QuNexus Editor Debug",
          "detail": "Build the QuNexus Editor debug binary",
          "groups": [
            [
              "QuNexus"
            ],
            "Debug"
          ],
          "order": 1
        }
      },
      "problemMatcher": [
        "$msCompile"
      ],
      "group": {
        "kind": "build"
      }
    },
    {
      "label": "QuNexus Win Build",
      "type": "process",
      "command": "${workspaceFolder}\\.vscode\\run-msvc-qmake-task.cmd",
      "args": [
        "..\\QuNexus.pro",
        "build",
        "${workspaceFolder}\\qt-qunexus\\build-QuNexus-Desktop_Qt_6_3_2_MSVC2019_64bit-Release"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "dedicatedTasks": {
          "label": "$(package) Build QuNexus Editor Release",
          "detail": "Build the QuNexus Editor release binary",
          "groups": [
            [
              "QuNexus"
            ],
            "Release"
          ],
          "order": 1
        }
      },
      "problemMatcher": [
        "$msCompile"
      ]
    },
    {
      "label": "QuNexus Win Clean",
      "type": "process",
      "command": "${workspaceFolder}\\.vscode\\run-msvc-qmake-task.cmd",
      "args": [
        "..\\QuNexus.pro",
        "clean"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\qt-qunexus\\build-QuNexus-Desktop_Qt_6_3_2_MSVC2019_64bit-Debug"
      },
      "problemMatcher": [
        "$msCompile"
      ]
    },
    {
      "label": "QuNexus Win Tail Log",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\tail-log.ps1",
        "${env:APPDATA}\\Keith McMillen Instruments\\QuNexus Editor\\logs"
      ],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "QuNexus Win Installer",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\make-installer.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "QuNexus Win Installer (No Signing)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\make-installer.ps1",
        "-DisableSigning"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "QuNexus Win Deploy",
      "dependsOrder": "sequence",
      "dependsOn": [
        "QuNexus Win Build",
        "QuNexus Win Installer"
      ],
      "problemMatcher": []
    },
    {
      "label": "QuNexus Win Deploy (No Signing)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "QuNexus Win Build",
        "QuNexus Win Installer (No Signing)"
      ],
      "problemMatcher": []
    },
    {
      "label": "QuNexus Mac Build",
      "type": "process",
      "command": "${workspaceFolder}/.vscode/run-qmake-task.sh",
      "args": [
        "${workspaceFolder}/qt-qunexus/QuNexus.pro",
        "build",
        "${workspaceFolder}/build-macos-release",
        "CONFIG+=release"
      ],
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build"
    },
    {
      "label": "QuNexus Mac Build (Debug)",
      "type": "process",
      "command": "${workspaceFolder}/.vscode/run-qmake-task.sh",
      "args": [
        "${workspaceFolder}/qt-qunexus/QuNexus.pro",
        "build",
        "${workspaceFolder}/build-macos-debug",
        "CONFIG+=debug"
      ],
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build"
    },
    {
      "label": "QuNexus Mac Clean",
      "type": "process",
      "command": "${workspaceFolder}/.vscode/run-qmake-task.sh",
      "args": [
        "${workspaceFolder}/qt-qunexus/QuNexus.pro",
        "clean",
        "${workspaceFolder}/build-macos-release"
      ],
      "problemMatcher": []
    },
    {
      "label": "QuNexus Mac Launch (Console)",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/launch-on-console.sh",
      "args": [
        "${workspaceFolder}/build-macos-release/QuNexus Editor.app/Contents/MacOS/QuNexus Editor"
      ],
      "dependsOn": [
        "QuNexus Mac Build"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      }
    },
    {
      "label": "QuNexus Mac Make DMG",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/make-dmg-mac.sh",
      "args": [
        "QuNexus Editor",
        "${workspaceFolder}/build-macos-release/QuNexus Editor.app"
      ],
      "options": {
        "env": {
          "KMI_VERSION_PRO": "${workspaceFolder}/qt-qunexus/QuNexus.pro",
          "KMI_QMLDIR": "${workspaceFolder}/qt-qunexus"
        }
      },
      "dependsOn": [
        "QuNexus Mac Build"
      ],
      "dependsOrder": "sequence",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "QuNexus Mac Deploy",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/release-github-mac.sh",
      "args": [
        "Muse-Kinetics/qunexus-qt6",
        "QuNexus Editor",
        "${workspaceFolder}/build-macos-release/QuNexus Editor.app"
      ],
      "options": {
        "env": {
          "KMI_VERSION_PRO": "${workspaceFolder}/qt-qunexus/QuNexus.pro"
        }
      },
      "dependsOn": [
        "QuNexus Mac Make DMG"
      ],
      "dependsOrder": "sequence",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
